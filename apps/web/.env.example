# Public build-time configuration. Never put provider API secrets in VITE_ variables.
VITE_APP_ENV=development
VITE_ENABLE_DEMO_FLIGHTS=true
VITE_ENABLE_PROVIDER_LOOKUP=true
# Server-side proxy endpoint (same origin by default). Never embed an API key here.
VITE_FLIGHT_PROXY_URL=/api/flights
VITE_FLIGHT_PROVIDER_TIMEOUT_MS=8000
