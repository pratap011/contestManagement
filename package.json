{
  "name": "blr-navigator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Flight-aware, OpenStreetMap-based wayfinding for Kempegowda International Airport (BLR)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "node --watch server/index.ts",
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "build": "npm run build:web",
    "start": "node server/index.ts",
    "preview": "npm --prefix apps/web run preview",
    "test": "npm run test:web && npm run test:server",
    "test:web": "npm --prefix apps/web run test",
    "test:server": "vitest run --config server/vitest.config.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && npm --prefix apps/web run typecheck",
    "data:osm": "node scripts/build-osm-data.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.13",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "fast-xml-parser": "^5.3.2",
    "supertest": "^7.1.4",
    "typescript": "~5.8.3",
    "vitest": "^3.2.7"
  },
  "author": "",
  "license": "ISC"
}
