# Server-side configuration. Every setting is optional: `docker compose up --build`
# generates a local session secret and database password, and the app falls back to
# embedded PGlite outside Docker. Copy this file to .env only to override something.
# Never commit real secrets.

NODE_ENV=development
PORT=8787

# Required outside Docker in production. Use a long random value, e.g.
# `openssl rand -hex 32`. Docker generates and persists one when omitted.
# In development, omit this to use the local-only default.
# JWT_SECRET=
# JWT_SECRET_FILE=.data/jwt-secret

# PostgreSQL in production. If omitted, the server uses an embedded
# PostgreSQL-compatible PGlite database under .data/pglite for local development.
# In Docker Compose this is derived from POSTGRES_PASSWORD; special characters are
# supported because the password is passed separately (PGPASSWORD).
# DATABASE_URL=postgres://user:password@localhost:5432/blr_navigator
# DATABASE_SSL=false
# Local Docker over HTTP needs COOKIE_SECURE=false; production HTTPS should use true.
# COOKIE_SECURE=false
# PGLITE_DATA_DIR=.data/pglite

# Comma-separated extra browser origins allowed to submit cookie-authenticated
# requests. Same-origin requests are always allowed. The web app and API must be
# same-origin for account cookies; APP_ORIGIN does not add CORS support.
# APP_ORIGIN=https://your-domain.example

# Optional live flight provider for future dates and for DEL/BOM/HYD/MAA/CCU.
# The BLR public board stays primary for today. AeroDataBox free plan:
# non-commercial, attribution required. Server-side only; never expose this in a
# VITE_ variable. Use the key from your RapidAPI subscription or your direct
# AeroDataBox account. The gateway is inferred from the base URL unless set.
# AERODATABOX_API_KEY=
# AERODATABOX_GATEWAY=rapidapi
# AERODATABOX_BASE_URL=https://aerodatabox.p.rapidapi.com
# AERODATABOX_HOST=aerodatabox.p.rapidapi.com
# For direct access instead:
# AERODATABOX_GATEWAY=direct
# AERODATABOX_BASE_URL=https://api.aerodatabox.com
# AERODATABOX_CACHE_TTL_MS=900000
# FLIGHT_PROVIDER_TIMEOUT_MS=6000
# FLIGHT_CACHE_TTL_MS=60000

# Live airport data. Weather works for all bundled airports. The BLR board and
# queue feeds need no key; queues are BLR-only.
# BLR_BOARD_URL=https://gateway.bengaluruairport.com/fis/v2/api/aodb/flights
# BLR_GATE_DIRECTORY_URL=https://gateway.bengaluruairport.com/fis/v2/api/aodb/gates
# BLR_QUEUE_URL=https://gateway.bengaluruairport.com/fis/v2/api/qms/general
# QUEUE_CACHE_TTL_MS=60000
# WEATHER_CACHE_TTL_MS=600000

# Optional OpenSky account for a higher ADS-B request allowance. Anonymous
# access works with a smaller daily credit budget.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# AIRCRAFT_CACHE_TTL_MS=45000

# Web Push. Generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Set the same pair in production; otherwise a local keypair is stored in
# .data/vapid.json and subscriptions break on redeploy.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# PUSH_POLL_INTERVAL_MS=300000
